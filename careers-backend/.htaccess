# Only careers-apply.php and careers-admin.php in this folder are meant to be
# requested directly. Block everything else (DB credentials, SQL schema, etc).
<FilesMatch "^(db_config\.php|schema\.sql|admin_config\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
